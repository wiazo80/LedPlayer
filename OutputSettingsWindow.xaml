<Window x:Class="LedPlayer.OutputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка вывода"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1B28">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#34344E"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4C4C72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A40"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderBrush" Value="#3A3A55"/>
            <Setter Property="CaretBrush" Value="#E8E8F0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">

        <TextBlock Text="МОНИТОРЫ" Foreground="#9A9AB0" FontSize="12"
                   FontWeight="Bold" Margin="0,0,0,6"/>
        <Border Background="#242436" CornerRadius="6" Padding="10,8">
            <TextBlock x:Name="MonitorsText" Foreground="#B8B8CC" FontSize="12"
                       FontFamily="Consolas" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="ПОЗИЦИЯ И РАЗМЕР ОКНА ВЫВОДА" Foreground="#9A9AB0"
                   FontSize="12" FontWeight="Bold" Margin="0,16,0,6"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="X" Foreground="#9A9AB0" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="TbX" Margin="0,0,10,6"/>
            <TextBlock Grid.Column="2" Text="Y" Foreground="#9A9AB0"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="TbY" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Text="Ширина" Foreground="#9A9AB0"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbW" Margin="0,0,10,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Высота" Foreground="#9A9AB0"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="3" x:Name="TbH"/>
        </Grid>

        <TextBlock Foreground="#6E6E88" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Подсказка: если LED-экран (1248×576) подключён справа от основного монитора 1920×1080, поставьте X=1920, Y=0, Ширина=1248, Высота=576."/>

        <StackPanel Margin="0,14,0,0">
            <CheckBox x:Name="CbTopmost" Content="Поверх всех окон"
                      Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"/>
            <CheckBox x:Name="CbSound" Content="Звук в окне вывода"
                      Checked="OnSoundChanged" Unchecked="OnSoundChanged"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Применить" Width="110" Click="OnApplyClick"/>
            <Button Content="Скрыть окно" Width="110" Margin="8,0,0,0" Click="OnHideClick"/>
            <Button Content="Закрыть" Width="90" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>